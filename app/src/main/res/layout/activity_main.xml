<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <FrameLayout
            android:id="@+id/workspaceContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gridRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="8dp" />

            <View
                android:id="@+id/pageEdgeLeft"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@android:color/transparent" />

            <View
                android:id="@+id/pageEdgeRight"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@android:color/transparent" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/pageIndicator"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/dockContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/dockBar"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dock"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <ImageButton
                android:id="@+id/drawerBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_settings_button"
                android:contentDescription="Меню приложений"
                android:src="@android:drawable/ic_dialog_dialer"
                android:visibility="gone"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/appDrawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_drawer"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:visibility="gone">

        <View
            android:id="@+id/drawerHandle"
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Все приложения"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/drawerSettingsBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Настройки меню"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/white" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/drawerRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="80dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_drawer_fade" />
        </FrameLayout>

        <EditText
            android:id="@+id/drawerSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_search_capsule"
            android:hint="Поиск"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/white"
            android:textColorHint="#99FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:id="@+id/animationOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF202020"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/quickPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_settings_panel"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <TextView android:id="@+id/quickWallpaper" android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center" android:padding="8dp" android:text="Обои" android:textColor="@color/white" android:textSize="12sp"/>
        <TextView android:id="@+id/quickSettings" android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center" android:padding="8dp" android:text="Настройки" android:textColor="@color/white" android:textSize="12sp"/>
        <TextView android:id="@+id/quickIcons" android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center" android:padding="8dp" android:text="Иконки" android:textColor="@color/white" android:textSize="12sp"/>
        <TextView android:id="@+id/quickWidgets" android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center" android:padding="8dp" android:text="Виджеты" android:textColor="@color/white" android:textSize="12sp"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_settings_button"
        android:contentDescription="@string/settings_title"
        android:padding="14dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_manage"
        android:visibility="gone"
        app:tint="@color/white" />

    <FrameLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF101010"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/settingsMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Настройки"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="Vibe Launcher"
                android:textColor="#99FFFFFF"
                android:textSize="14sp" />

            <LinearLayout android:id="@+id/catRowAppearance" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/bg_settings_panel" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Внешний вид" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#99FFFFFF" android:textSize="22sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/catRowAnimations" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/bg_settings_panel" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Анимации" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#99FFFFFF" android:textSize="22sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/catRowHome" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/bg_settings_panel" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Рабочий стол и экран" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#99FFFFFF" android:textSize="22sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/catRowDrawer" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/bg_settings_panel" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Меню приложений" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#99FFFFFF" android:textSize="22sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/catRowPower" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/bg_settings_panel" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Энергосбережение" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#99FFFFFF" android:textSize="22sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/catRowAbout" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/bg_settings_panel" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="О лаунчере" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#99FFFFFF" android:textSize="22sp"/>
            </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/settingsDetail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="16dp">
                <ImageButton
                    android:id="@+id/settingsBackBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="@color/white" />
                <TextView
                    android:id="@+id/settingsDetailTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Настройки"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout android:id="@+id/catAppearance" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/labelsSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Подписи иконок" android:textColor="@color/white" />
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/lightModeSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Светлый режим" android:textColor="@color/white" />
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/liquidGlassSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Жидкое стекло" android:textColor="@color/white" />
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/liquidWobbleSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Желе-эффект при закрытии" android:textColor="@color/white" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Интенсивность желе" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/liquidWobbleSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
                        <Button android:id="@+id/animPresetBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Пресет анимации: Пользовательская" />
                        <Button android:id="@+id/dockStyleBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Стиль дока: Размытие" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Масштаб иконок" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/iconScaleSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="80"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Отступы слева/справа" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/gridSideMarginSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="64"/>
                        <TextView android:id="@+id/iconPackLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Пакет иконок: системный" android:textColor="@color/white" />
                        <Button android:id="@+id/pickIconPackBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Выбрать пакет иконок" />
                        <Button android:id="@+id/wallpaperBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Обои" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Цвет акцента" android:textColor="@color/white" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                            <View android:id="@+id/accentPurple" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="#7C4DFF"/>
                            <View android:id="@+id/accentBlue" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="#448AFF"/>
                            <View android:id="@+id/accentGreen" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="#00C853"/>
                            <View android:id="@+id/accentOrange" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="#FF6D00"/>
                            <View android:id="@+id/accentPink" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="8dp" android:background="#FF4081"/>
                            <View android:id="@+id/accentRed" android:layout_width="36dp" android:layout_height="36dp" android:background="#FF5252"/>
                        </LinearLayout>
                        <TextView android:id="@+id/iconShapeLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Форма иконок: круглая" android:textColor="@color/white" />
                        <Button android:id="@+id/iconShapeBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Форма иконок" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Предпросмотр формы" android:textColor="#CCFFFFFF" android:layout_marginTop="8dp"/>
                        <ImageView android:id="@+id/cornerPreviewIcon" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginTop="6dp" android:layout_gravity="center_horizontal" android:src="@android:drawable/sym_def_app_icon" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Радиус всех углов" android:textColor="#CCFFFFFF" android:layout_marginTop="8dp"/>
                        <SeekBar android:id="@+id/radiusAllSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Верх-лево / Верх-право" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/radiusTLSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
                        <SeekBar android:id="@+id/radiusTRSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Низ-лево / Низ-право" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/radiusBLSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
                        <SeekBar android:id="@+id/radiusBRSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
                        <Button android:id="@+id/resetCornersBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сбросить углы"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/catAnimations" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/flagshipSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Флагманские анимации" android:textColor="@color/white" />
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/blurSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Расширенные текстуры" android:textColor="@color/white" />
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/dockHideSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="Скрывать док при открытии/закрытии" android:textColor="@color/white" />
                        <Button android:id="@+id/dockHideStyleBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Стиль скрытия дока: Слайд" />
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/tiltSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="false" android:text="Эксперимент: наклон окон (iOS 26)" android:textColor="@color/white" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Интенсивность наклона" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/tiltIntensitySeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Закругление окон" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/windowCornerSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="60"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Открытие: длительность" android:textColor="#CCFFFFFF" android:layout_marginTop="12dp"/>
                        <SeekBar android:id="@+id/openDurationSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="600"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Закрытие: длительность" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/closeDurationSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="600"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Открытие: масштаб" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/openScaleSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Закрытие: масштаб" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/closeScaleSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Закрытие: высота дуги (физика)" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/closeTySeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="600"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Отскок при закрытии" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/overshootSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="150"/>
                        <TextView android:id="@+id/unlockAnimLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Анимация разблокировки: Pixel" android:textColor="@color/white" />
                        <Button android:id="@+id/unlockAnimBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Анимация разблокировки" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/catHome" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/desktopModeSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Режим ПК/планшета в горизонтали" android:textColor="@color/white" />
                        <TextView android:id="@+id/landDockLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Док в горизонтали: справа" android:textColor="@color/white" />
                        <Button android:id="@+id/landDockBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Положение дока (горизонт.)"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Масштаб дока" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/dockScaleSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="70"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Строки сетки" android:textColor="#CCFFFFFF" android:layout_marginTop="8dp"/>
                        <SeekBar android:id="@+id/gridRowsSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="4"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сетка (портрет): колонки" android:textColor="#CCFFFFFF" android:layout_marginTop="8dp"/>
                        <SeekBar android:id="@+id/portColsSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="3"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сетка (портрет): отступы" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/portPadSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="40"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сетка (горизонт.): колонки" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/landColsSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="4"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сетка (горизонт.): отступы" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/landPadSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="40"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Горизонт.: масштаб иконок" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/landScaleSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="60"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Масштаб экрана (лаунчер)" android:textColor="#CCFFFFFF"/>
                        <SeekBar android:id="@+id/screenScaleSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="150"/>
                        <TextView android:id="@+id/screenScaleLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="100%" android:textColor="#99FFFFFF" android:textSize="12sp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Частота обновления (предпочтение)" android:textColor="#CCFFFFFF"/>
                        <Button android:id="@+id/refreshRateBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Гц: Авто" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/catDrawer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <TextView android:id="@+id/drawerStyleLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Меню приложений: свайп вверх" android:textColor="@color/white" />
                        <Button android:id="@+id/drawerStyleBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Стиль меню приложений" />
                        <TextView android:id="@+id/drawerLayoutLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Вид меню: сетка" android:textColor="@color/white" />
                        <Button android:id="@+id/drawerLayoutBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Вид меню приложений" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/catPower" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/powerSavingSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Режим энергосбережения" android:textColor="@color/white" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Затемняет иконки и обои, отключает расширенные текстуры, упрощает анимации и может снизить яркость." android:textColor="#CCFFFFFF" android:textSize="13sp"/>
                        <Button android:id="@+id/powerBrightnessPermBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Разрешить управление яркостью" />
                        <Button android:id="@+id/powerBrightnessLowBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Снизить яркость" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/catAbout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <LinearLayout android:id="@+id/aboutCardBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_settings_panel" android:orientation="vertical" android:padding="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vibe Launcher" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/aboutCardVersion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.9.3-beta" android:textColor="#CCFFFFFF" android:layout_marginTop="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Нажмите, чтобы открыть подробности" android:textColor="#99FFFFFF" android:layout_marginTop="8dp" android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/volumePanel"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_settings_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♫" android:textColor="@color/white" android:textSize="14sp"/>
        <SeekBar android:id="@+id/volMedia" android:layout_width="180dp" android:layout_height="wrap_content" android:rotation="270" android:layout_marginTop="70dp" android:layout_marginBottom="70dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔔" android:textColor="#CCFFFFFF" android:textSize="12sp"/>
        <SeekBar android:id="@+id/volRing" android:layout_width="140dp" android:layout_height="wrap_content" android:rotation="270" android:layout_marginTop="52dp" android:layout_marginBottom="52dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•" android:textColor="#CCFFFFFF" android:textSize="12sp"/>
        <SeekBar android:id="@+id/volNotif" android:layout_width="140dp" android:layout_height="wrap_content" android:rotation="270" android:layout_marginTop="52dp" android:layout_marginBottom="52dp"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/aboutOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/aboutGradientBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF10131A" />

        <LinearLayout
            android:id="@+id/aboutCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="@drawable/bg_settings_panel"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/aboutTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vibe Launcher"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/aboutVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Version"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/aboutDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Device"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp" />
            <Button
                android:id="@+id/aboutGithubBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Open GitHub" />
            <Button
                android:id="@+id/aboutCloseBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Close" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/devOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2111111"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Developer Mode" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Icon press behavior" android:textColor="#CCFFFFFF"/>
        <Button android:id="@+id/devIconBehaviorBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Press scale + fly (default)"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Close animation style" android:textColor="#CCFFFFFF"/>
        <Button android:id="@+id/devCloseStyleBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Morph to icon"/>
        <Button android:id="@+id/devCloseDevBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Close"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/folderOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#99000000" />
        <LinearLayout
            android:id="@+id/folderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="@drawable/bg_settings_panel"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView android:id="@+id/folderTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Папка" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/folderRecycler" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
            <TextView android:id="@+id/folderResizeHandle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:padding="8dp" android:text="⇲ Размер" android:textColor="#CCFFFFFF" android:textSize="13sp"/>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/iconMenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/iconMenuBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000" />

        <ImageView
            android:id="@+id/iconMenuPreview"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/iconMenuCard"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_panel"
            android:orientation="vertical"
            android:padding="8dp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/welcomeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF0A0A0A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="260dp"
            android:layout_height="260dp">

            <View
                android:id="@+id/welcomeShape1"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_welcome_shape1" />

            <View
                android:id="@+id/welcomeShape2"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_welcome_shape2" />

            <View
                android:id="@+id/welcomeShape3"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="bottom|start"
                android:background="@drawable/bg_welcome_shape3" />
        </FrameLayout>

        <TextView
            android:id="@+id/welcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Vibe Launcher"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/welcomeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Быстрый, лёгкий и настраиваемый рабочий стол"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/welcomeStartBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Начать" />

        <LinearLayout
            android:id="@+id/welcomeChoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/welcomeWallpaperCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Установить фирменные ч/б обои"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/welcomeAutoBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Авторасстановка" />

            <Button
                android:id="@+id/welcomeEmptyBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Пустой рабочий стол" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
